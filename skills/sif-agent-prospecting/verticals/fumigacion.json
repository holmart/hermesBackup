      "moviaseo.com", "terserpro.com", "ecolimpiezabogota.com.co",
      "industriaslyf.com"
    ]
  },

  "validation": {
    "llm_context": "Empresa de fumigación o control de plagas en Colombia. Valida si parece una empresa real del sector (no una de aseo general, no un directorio, no una multinacional genérica).",
    "disqualify_keywords": ["aseo general", "limpieza doméstica", "lavandería"]
